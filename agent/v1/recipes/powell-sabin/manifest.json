{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "point",
    "curve",
    "categorical",
    "explode",
    "legend"
  ],
  "id": "powell-sabin",
  "inputs": [
    {
      "attributes": [
        {
          "channels": 1,
          "element": "indexed",
          "name": "vertex_label",
          "usage": "scalar"
        }
      ],
      "geometry": "surface",
      "id": "mesh",
      "path": "data/powell_sabin.ply"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/powell_sabin.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/powell_sabin.html"
    }
  ],
  "script": "powell_sabin.py",
  "summary": "Combine categorized vertices, edges, surfaces, and exploded components.",
  "title": "Powell-Sabin Splines"
}
