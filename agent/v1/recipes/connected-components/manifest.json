{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "categorical",
    "components",
    "legend",
    "multi-view"
  ],
  "id": "connected-components",
  "inputs": [
    {
      "geometry": "surface",
      "id": "mesh",
      "path": "data/foot.ply"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/foot_front.webp"
    },
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/foot_top.webp"
    },
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/foot_side.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/foot.html"
    }
  ],
  "script": "components.py",
  "summary": "Compute and render connected surface components as categorical colors.",
  "title": "Connected Components"
}
