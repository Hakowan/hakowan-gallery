{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "curve",
    "wireframe",
    "composition"
  ],
  "id": "spot",
  "inputs": [
    {
      "geometry": "surface",
      "id": "mesh",
      "path": "data/spot_quadrangulated.obj"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/spot_wireframe.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/spot_wireframe.html"
    }
  ],
  "script": "spot.py",
  "summary": "Render a basic surface mesh with its polygon-edge wireframe overlaid.",
  "title": "Spot"
}
