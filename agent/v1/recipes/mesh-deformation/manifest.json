{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "filter",
    "comparison",
    "multi-view",
    "materials"
  ],
  "id": "mesh-deformation",
  "inputs": [
    {
      "attributes": [
        {
          "channels": 1,
          "element": "facet",
          "name": "label",
          "usage": "scalar"
        }
      ],
      "geometry": "surface",
      "id": "mesh",
      "path": "data/cylinder_1.msh"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/cylinder_1.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/cylinders.html"
    }
  ],
  "script": "render.py",
  "summary": "Compare deformed meshes while separating handles from the free region.",
  "title": "Mesh Deformation"
}
