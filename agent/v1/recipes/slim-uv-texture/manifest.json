{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "uv",
    "image-texture",
    "rotation"
  ],
  "id": "slim-uv-texture",
  "inputs": [
    {
      "attributes": [
        {
          "channels": 2,
          "element": "indexed",
          "name": "texcoord",
          "usage": "uv"
        }
      ],
      "geometry": "surface",
      "id": "mesh",
      "path": "data/fig3.obj"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/fig3.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/fig3.html"
    }
  ],
  "script": "slim.py",
  "summary": "Render parameterized surfaces with a repeated image texture.",
  "title": "Scalable Locally Injective Maps"
}
