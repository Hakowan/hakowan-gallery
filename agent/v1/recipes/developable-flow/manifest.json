{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "computed-normal",
    "comparison",
    "camera"
  ],
  "id": "developable-flow",
  "inputs": [
    {
      "geometry": "surface",
      "id": "mesh",
      "path": "data/mask_triangulated.obj"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/mask_0.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/mask.html"
    }
  ],
  "script": "developable.py",
  "summary": "Compare successive developable-surface optimization iterations.",
  "title": "Developable Surface Flow"
}
