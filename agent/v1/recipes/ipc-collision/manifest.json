{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "deformation",
    "glass",
    "orthographic",
    "multi-view"
  ],
  "id": "ipc-collision",
  "inputs": [
    {
      "geometry": "surface",
      "id": "ball",
      "path": "data/10.obj"
    },
    {
      "geometry": "surface",
      "id": "plate",
      "path": "data/plate2.obj"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/ipc_side_10.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/ipc.html"
    }
  ],
  "script": "ipc.py",
  "summary": "Compare deforming collision states against a transparent contact plate.",
  "title": "Incremental Potential Contact"
}
