{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "scalar-field",
    "comparison",
    "layout",
    "legend",
    "z-up"
  ],
  "id": "mean-curvature-flow",
  "inputs": [
    {
      "attributes": [
        {
          "channels": 1,
          "element": "indexed",
          "name": "dist",
          "usage": "scalar"
        }
      ],
      "geometry": "surface",
      "id": "surface",
      "path": "data/flow_00.ply"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/bust.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/bust_all.html"
    }
  ],
  "script": "flow.py",
  "summary": "Compare a surface evolution and its signed distance field over time.",
  "title": "Mean Curvature Flow"
}
