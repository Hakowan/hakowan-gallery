{
  "backends": [
    "blender",
    "webgl"
  ],
  "features": [
    "surface",
    "conductor",
    "render-passes",
    "normal",
    "depth"
  ],
  "id": "penny-material-passes",
  "inputs": [
    {
      "geometry": "surface",
      "id": "mesh",
      "path": "data/penny.glb"
    }
  ],
  "outputs": [
    {
      "backend": "blender",
      "kind": "image",
      "path": "results/penny.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/penny.html"
    }
  ],
  "script": "penny.py",
  "summary": "Render a scanned penny with copper material and semantic passes.",
  "title": "Penny"
}
