{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "curve",
    "categorical",
    "composition",
    "materials"
  ],
  "id": "fiber-curves",
  "inputs": [
    {
      "geometry": "curve",
      "id": "fibers",
      "path": "data/fibers.obj"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/fibers.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/fibers.html"
    }
  ],
  "script": "fibers.py",
  "summary": "Render separated yarn fibers as individually colored curves.",
  "title": "Fiber Curves"
}
