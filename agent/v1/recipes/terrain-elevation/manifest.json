{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "heightmap",
    "scalar-field",
    "legend",
    "camera"
  ],
  "id": "terrain-elevation",
  "inputs": [
    {
      "geometry": "heightmap",
      "id": "terrain",
      "path": "data/USGS_1_n35w112.tif"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/usgs_1_n35112.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/usgs_1_n35112.html"
    }
  ],
  "script": "elevation.py",
  "summary": "Convert a height image to terrain and map elevation to color.",
  "title": "Elevation Map"
}
