{
  "backends": [
    "mitsuba",
    "webgl"
  ],
  "features": [
    "surface",
    "image-texture",
    "bump-map",
    "z-up",
    "two-view"
  ],
  "id": "moon-textures",
  "inputs": [
    {
      "geometry": "surface",
      "id": "mesh",
      "path": "data/moon.ply"
    }
  ],
  "outputs": [
    {
      "backend": "mitsuba",
      "kind": "image",
      "path": "results/moon.webp"
    },
    {
      "backend": "webgl",
      "kind": "interactive",
      "path": "results/moon.html"
    }
  ],
  "script": "moon.py",
  "summary": "Render lunar color and elevation imagery as color and bump textures.",
  "title": "Moon"
}
